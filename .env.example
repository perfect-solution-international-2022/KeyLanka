DATABASE_URL="mysql://user:password@localhost:3306/keylanka"
JWT_SECRET="replace_with_at_least_32_random_characters"
# Optional separate secret for hashing one-time admin login codes.
ADMIN_MFA_SECRET=""
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""
ADMIN_SEED_NAME="Key Lanka Admin"
# Protects /api/cron/expire-orders. Use a random value of at least 16 characters.
CRON_SECRET=""

# Only set this when requests always pass through a trusted reverse proxy.
# Examples: x-real-ip, cf-connecting-ip. Leave blank for direct hosting.
TRUSTED_PROXY_IP_HEADER=""

# Required for uploads in production. ClamAV's clamd INSTREAM service.
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"

# OnePay payment gateway (https://docs.onepay.lk) — server-side only
ONEPAY_APP_ID=""
ONEPAY_APP_TOKEN=""
ONEPAY_HASH_SALT=""
ONEPAY_API_BASE="https://api.onepay.lk"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GOOGLE_SITE_VERIFICATION=""

# SMTP — used for forgot-password emails, order confirmation emails, and the
# contact form. If port 465 (implicit TLS) doesn't connect from your host,
# try 587 with SMTP_SECURE="false" (STARTTLS) instead.
SMTP_HOST="mail.keylanka.lk"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Key Lanka <info@keylanka.lk>"
CONTACT_TO_EMAIL="info@keylanka.lk"
