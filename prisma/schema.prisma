generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id              Int        @id @default(autoincrement())
  name            String
  slug            String     @unique
  image           String?
  restricted      Boolean    @default(false)
  parentId        Int?
  parent          Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryToCategory")
  primaryProducts Product[]  @relation("PrimaryCategory")
  products        Product[]  @relation("ProductCategories")
  createdAt       DateTime   @default(now())
  deletedAt       DateTime?

  @@index([parentId])
  @@index([deletedAt])
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  logo      String?
  products  Product[]
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([deletedAt])
}

model Product {
  id                Int              @id @default(autoincrement())
  name              String
  slug              String           @unique
  sku               String           @unique
  price             Decimal          @db.Decimal(10, 2)
  compareAtPrice    Decimal?         @db.Decimal(10, 2)
  wholesalePrice    Decimal?         @db.Decimal(10, 2)
  wholesaleMinQty   Int              @default(10)
  stock             Int              @default(0)
  lowStockThreshold Int              @default(10)
  allowBackorder    Boolean          @default(false)
  soldIndividually  Boolean          @default(false)
  allowNoWarranty   Boolean          @default(true)
  rating            Decimal          @default(0) @db.Decimal(2, 1)
  reviewCount       Int              @default(0)
  badge             String?
  featured          Boolean          @default(false)
  shortDescription  String?          @db.Text
  description       String?          @db.Text
  seoTitle          String?
  metaDescription   String?          @db.Text
  focusKeywords     String?          @db.Text
  imageAlt          String?
  images            Json
  attributes        Json?
  productType       String?
  categoryId        Int
  category          Category         @relation("PrimaryCategory", fields: [categoryId], references: [id])
  categories        Category[]       @relation("ProductCategories")
  brandId           Int?
  brand             Brand?           @relation(fields: [brandId], references: [id])
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  orderItems        OrderItem[]
  variants          ProductVariant[]
  warranties        Warranty[]       @relation("ProductWarranties")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  @@index([categoryId])
  @@index([brandId])
  @@index([deletedAt])
  @@index([deletedAt, featured, createdAt])
  @@index([deletedAt, categoryId])
}

model Attribute {
  id        Int              @id @default(autoincrement())
  name      String
  slug      String           @unique
  values    AttributeValue[]
  createdAt DateTime         @default(now())
  deletedAt DateTime?

  @@index([deletedAt])
}

model AttributeValue {
  id            Int                   @id @default(autoincrement())
  attributeId   Int
  attribute     Attribute             @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value         String
  variantValues ProductVariantValue[]
  createdAt     DateTime              @default(now())
  deletedAt     DateTime?

  @@index([attributeId])
  @@index([deletedAt])
}

model ProductVariant {
  id                Int                   @id @default(autoincrement())
  productId         Int
  product           Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String                @unique
  price             Decimal               @db.Decimal(10, 2)
  compareAtPrice    Decimal?              @db.Decimal(10, 2)
  wholesalePrice    Decimal?              @db.Decimal(10, 2)
  productCost       Decimal?              @db.Decimal(10, 2)
  stockStatus       String                @default("in_stock")
  stock             Int                   @default(0)
  lowStockThreshold Int                   @default(10)
  weightKg          Decimal?              @db.Decimal(10, 2)
  lengthCm          Decimal?              @db.Decimal(10, 2)
  widthCm           Decimal?              @db.Decimal(10, 2)
  heightCm          Decimal?              @db.Decimal(10, 2)
  image             String?
  isDefault         Boolean               @default(false)
  values            ProductVariantValue[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([productId])
}

model ProductVariantValue {
  productVariantId Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  attributeValueId Int
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productVariantId, attributeValueId])
  @@index([attributeValueId])
}

enum Role {
  BUYER
  ADMIN
}

model User {
  id                   Int                   @id @default(autoincrement())
  name                 String
  email                String                @unique
  passwordHash         String
  phone                String?
  role                 Role                  @default(BUYER)
  sessionVersion       Int                   @default(0)
  mustResetPassword    Boolean               @default(false)
  suspendedAt          DateTime?
  suspensionReason     String?               @db.Text
  locksmithStatus      String? // null | "pending" | "approved" | "rejected"
  locksmithApplication LocksmithApplication?
  addresses            Address[]
  cartItems            CartItem[]
  wishlistItems        WishlistItem[]
  orders               Order[]
  uploadAssets         UploadAsset[]
  adminLoginChallenges AdminLoginChallenge[]
  securityAuditLogs    SecurityAuditLog[]
  createdAt            DateTime              @default(now())

  @@index([role, suspendedAt])
}

model AdminLoginChallenge {
  id         String    @id @default(cuid()) @db.VarChar(191)
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String    @db.Char(64)
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model SecurityAuditLog {
  id          String   @id @default(cuid()) @db.VarChar(191)
  actorUserId Int?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String   @db.VarChar(64)
  targetType  String?  @db.VarChar(64)
  targetId    String?  @db.VarChar(191)
  ipHash      String?  @db.Char(64)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
}

model UploadAsset {
  id                String   @id @default(cuid()) @db.VarChar(191)
  ownerId           Int?
  owner             User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  visibility        String   @db.VarChar(16)
  purpose           String   @db.VarChar(32)
  originalName      String
  contentType       String   @db.VarChar(100)
  bytes             Bytes    @db.LongBlob
  createdAt         DateTime @default(now())
  bankTransferOrder Order?   @relation("BankTransferSlip")

  @@index([ownerId])
  @@index([visibility, purpose])
}

model RateLimitBucket {
  key         String   @id @db.VarChar(191)
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt
}

model LocksmithApplication {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id])
  fullName        String
  mobileNumber    String
  email           String
  businessName    String
  businessRegDocs Json
  nationalIdFront String
  nationalIdBack  String
  address         String    @db.Text
  utilityBillDoc  String
  status          String    @default("pending")
  rejectionReason String?   @db.Text
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  fullName  String
  line1     String
  city      String
  phone     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model CartItem {
  id         Int             @id @default(autoincrement())
  userId     Int?
  sessionId  String?
  productId  Int
  product    Product         @relation(fields: [productId], references: [id])
  variantId  Int?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  warrantyId Int?
  warranty   Warranty?       @relation(fields: [warrantyId], references: [id])
  user       User?           @relation(fields: [userId], references: [id])
  quantity   Int             @default(1)
  createdAt  DateTime        @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([productId])
  @@index([variantId])
  @@index([warrantyId])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int?
  sessionId String?
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([productId])
}

model Order {
  id                   Int          @id @default(autoincrement())
  userId               Int
  user                 User         @relation(fields: [userId], references: [id])
  status               String       @default("pending")
  total                Decimal      @db.Decimal(10, 2)
  shippingCost         Decimal      @default(0) @db.Decimal(10, 2)
  shippingName         String
  shippingLine1        String
  shippingCity         String
  shippingDistrict     String       @default("")
  shippingPostalCode   String       @default("")
  shippingPhone        String
  paymentMethod        String       @default("cod")
  paid                 Boolean      @default(false)
  transactionId        String?      @unique
  paymentStatusMessage String?
  paymentSlipAssetId   String?      @unique @db.VarChar(191)
  paymentSlip          UploadAsset? @relation("BankTransferSlip", fields: [paymentSlipAssetId], references: [id])
  policyAgreement      Json?
  items                OrderItem[]
  createdAt            DateTime     @default(now())
  deletedAt            DateTime?

  @@index([userId])
  @@index([deletedAt])
  @@index([deletedAt, status, createdAt])
  @@index([userId, deletedAt, createdAt])
}

model ShippingSettings {
  id           Int      @id @default(1)
  shippingCost Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt    DateTime @updatedAt
}

model BankTransferSettings {
  id            Int      @id @default(1)
  enabled       Boolean  @default(false)
  bankName      String   @default("") @db.VarChar(120)
  branchName    String   @default("") @db.VarChar(120)
  accountName   String   @default("") @db.VarChar(160)
  accountNumber String   @default("") @db.VarChar(80)
  updatedAt     DateTime @updatedAt
}

model MaintenanceSettings {
  id        Int      @id @default(1)
  enabled   Boolean  @default(false)
  message   String?  @db.VarChar(500)
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id            Int             @id @default(autoincrement())
  orderId       Int
  order         Order           @relation(fields: [orderId], references: [id])
  productId     Int
  product       Product         @relation(fields: [productId], references: [id])
  variantId     Int?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  name          String
  sku           String?
  price         Decimal         @db.Decimal(10, 2)
  quantity      Int
  warrantyName  String?
  warrantyDays  Int?
  warrantyPrice Decimal         @default(0) @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Warranty {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(120)
  days      Int
  price     Decimal    @default(0) @db.Decimal(10, 2)
  active    Boolean    @default(true)
  products  Product[]  @relation("ProductWarranties")
  cartItems CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Policy {
  key       String   @id @db.VarChar(40)
  title     String   @db.VarChar(160)
  content   String   @db.LongText
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Service {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  description String    @db.Text
  icon        String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([deletedAt])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String   @db.Text
  createdAt DateTime @default(now())
}
